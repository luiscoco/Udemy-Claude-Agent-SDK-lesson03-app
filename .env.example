# Copy to .env. Enter your own API key; never commit .env.
ANTHROPIC_API_KEY=your_api_key
CLAUDE_MODEL=claude-sonnet-4-6
PORT=3103
# Windows: set this only if Git Bash is not detected automatically.
# CLAUDE_CODE_GIT_BASH_PATH=C:/Program Files/Git/bin/bash.exe
# Python 3.10+ runs the host regression checks.
PYTHON_BIN=python
